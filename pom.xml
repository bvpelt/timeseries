<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>

	<groupId>com.bsoft</groupId>
	<artifactId>timeseries</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>timeseries</name>
	<description>Bitemporal Person-Address-Agreement Service</description>

	<properties>
		<java.version>21</java.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<openapi-generator.version>7.11.0</openapi-generator.version>
		<springdoc.version>2.8.8</springdoc.version>
		<jackson-databind-nullable.version>0.2.6</jackson-databind-nullable.version>
		<generated-sources-path>${project.build.directory}/generated-sources/openapi</generated-sources-path>
	</properties>

	<dependencies>
		<!-- ===== WEB ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- ===== SECURITY ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- ===== JWT ====== -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
		</dependency>

		<!-- ===== DATA ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ===== DATABASE MIGRATIONS ===== -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- ===== OPENAPI / SWAGGER UI ===== -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<!-- Required by generated OpenAPI model classes for Optional fields -->
		<dependency>
			<groupId>org.openapitools</groupId>
			<artifactId>jackson-databind-nullable</artifactId>
			<version>${jackson-databind-nullable.version}</version>
		</dependency>

		<!-- ===== MAPPING ===== -->
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${mapstruct.version}</version>
		</dependency>

		<!-- ===== UTILITIES ===== -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ===== DEV TOOLS ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>


		<!-- ===== TEST ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<!-- Include generated sources in the build -->
		<plugins>

			<!-- ===== OPENAPI CODE GENERATOR ===== -->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-generator.version}</version>
				<executions>
					<execution>
						<id>generate-api-timeseries</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/timeseries.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.bsoft.timeseries.timeseries.api</apiPackage>
							<modelPackage>com.bsoft.timeseries.timeseries.model</modelPackage>
							<generateApiTests>true</generateApiTests>
							<generateModelTests>true</generateModelTests>
							<generateApiDocumentation>true</generateApiDocumentation>
							<generateModelDocumentation>true</generateModelDocumentation>
							<output>${generated-sources-path}</output>
							<configOptions>
								<!-- Use delegate pattern: generated controller delegates to our impl -->
								<delegatePattern>true</delegatePattern>
								<!-- Spring Boot 3/4 compatible (Jakarta EE 9+) -->
								<useSpringBoot3>true</useSpringBoot3>
								<useJakartaEe>true</useJakartaEe>
								<!-- Use java.time classes -->
								<dateLibrary>java8</dateLibrary>
								<!-- Group by OpenAPI tag name -->
								<useTags>true</useTags>
								<!-- Generate interfaces, not full controller implementations -->
								<interfaceOnly>true</interfaceOnly>
								<!-- Add Bean Validation annotations to model -->
								<useBeanValidation>true</useBeanValidation>
								<!-- Use @SpringBootApplication-friendly component scan -->
								<basePackage>com.bsoft.timeseries</basePackage>
								<!-- Do NOT inject Lombok annotations onto generated model classes:
                                     the generator already emits its own constructors/getters/setters.
                                     Adding @NoArgsConstructor / @AllArgsConstructor here causes
                                     "constructor already defined" compile errors. -->
							</configOptions>
						</configuration>
					</execution>

					<execution>
						<id>generate-api-login</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/login.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.bsoft.timeseries.login.api</apiPackage>
							<modelPackage>com.bsoft.timeseries.login.model</modelPackage>
							<generateApiTests>true</generateApiTests>
							<generateModelTests>true</generateModelTests>
							<generateApiDocumentation>true</generateApiDocumentation>
							<generateModelDocumentation>true</generateModelDocumentation>
							<output>${generated-sources-path}</output>
							<configOptions>
								<!-- Use delegate pattern: generated controller delegates to our impl -->
								<delegatePattern>true</delegatePattern>
								<!-- Spring Boot 3/4 compatible (Jakarta EE 9+) -->
								<useSpringBoot3>true</useSpringBoot3>
								<useJakartaEe>true</useJakartaEe>
								<!-- Use java.time classes -->
								<dateLibrary>java8</dateLibrary>
								<!-- Group by OpenAPI tag name -->
								<useTags>true</useTags>
								<!-- Generate interfaces, not full controller implementations -->
								<interfaceOnly>true</interfaceOnly>
								<!-- Add Bean Validation annotations to model -->
								<useBeanValidation>true</useBeanValidation>
								<!-- Use @SpringBootApplication-friendly component scan -->
								<basePackage>com.bsoft.timeseries</basePackage>
								<!-- Do NOT inject Lombok annotations onto generated model classes:
                                     the generator already emits its own constructors/getters/setters.
                                     Adding @NoArgsConstructor / @AllArgsConstructor here causes
                                     "constructor already defined" compile errors. -->
							</configOptions>
						</configuration>
					</execution>

					<execution>
						<id>generate-api-authentication</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/authentication.yaml</inputSpec>
							<generatorName>spring</generatorName>
							<apiPackage>com.bsoft.timeseries.authentication.api</apiPackage>
							<modelPackage>com.bsoft.timeseries.authentication.model</modelPackage>
							<generateApiTests>true</generateApiTests>
							<generateModelTests>true</generateModelTests>
							<generateApiDocumentation>true</generateApiDocumentation>
							<generateModelDocumentation>true</generateModelDocumentation>
							<output>${generated-sources-path}</output>
							<configOptions>
								<!-- Use delegate pattern: generated controller delegates to our impl -->
								<delegatePattern>true</delegatePattern>
								<!-- Spring Boot 3/4 compatible (Jakarta EE 9+) -->
								<useSpringBoot3>true</useSpringBoot3>
								<useJakartaEe>true</useJakartaEe>
								<!-- Use java.time classes -->
								<dateLibrary>java8</dateLibrary>
								<!-- Group by OpenAPI tag name -->
								<useTags>true</useTags>
								<!-- Generate interfaces, not full controller implementations -->
								<interfaceOnly>true</interfaceOnly>
								<!-- Add Bean Validation annotations to model -->
								<useBeanValidation>true</useBeanValidation>
								<!-- Use @SpringBootApplication-friendly component scan -->
								<basePackage>com.bsoft.timeseries</basePackage>
								<!-- Do NOT inject Lombok annotations onto generated model classes:
                                     the generator already emits its own constructors/getters/setters.
                                     Adding @NoArgsConstructor / @AllArgsConstructor here causes
                                     "constructor already defined" compile errors. -->
							</configOptions>
						</configuration>
					</execution>


				</executions>
			</plugin>

			<!-- ===== SPRING BOOT PLUGIN ===== -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Explicitly set main class because the OpenAPI generator also emits
                         OpenApiGeneratorApplication.java with a main method into the
                         generated-sources folder, causing "Unable to find a single main class"
                         at startup. Pinning it here resolves the ambiguity. -->
					<mainClass>com.bsoft.timeseries.TimeseriesApplication</mainClass>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- ===== COMPILER PLUGIN (Lombok + MapStruct ordering) ===== -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<parameters>true</parameters>
					<!-- Lombok MUST be listed before MapStruct -->
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${mapstruct.version}</version>
						</path>
						<!-- Nodig voor samenwerking tussen Lombok en MapStruct -->
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>0.2.0</version>
						</path>
					</annotationProcessorPaths>
					<compilerArgs>
						<!-- Tell MapStruct to use the Lombok-generated builder -->
						<arg>-Amapstruct.defaultComponentModel=spring</arg>
					</compilerArgs>
				</configuration>
			</plugin>


			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-site-plugin</artifactId>
				<version>3.12.1</version>
			</plugin>

			<plugin>
				<groupId>pl.project13.maven</groupId>
				<artifactId>git-commit-id-plugin</artifactId>
				<version>4.9.10</version>
			</plugin>

			<!-- ===== FLYWAY PLUGIN (optional: for mvn flyway:migrate) ===== -->
			<plugin>
				<groupId>org.flywaydb</groupId>
				<artifactId>flyway-maven-plugin</artifactId>
				<configuration>
					<url>${SPRING_DATASOURCE_URL}</url>
					<user>${SPRING_DATASOURCE_USERNAME}</user>
					<password>${SPRING_DATASOURCE_PASSWORD}</password>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>get-mockito-agent-path</id>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>